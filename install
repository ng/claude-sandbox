#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

echo "Building claude-sandbox image..."
docker compose -f "$SCRIPT_DIR/docker-compose.yml" build

ENV_FILE="$SCRIPT_DIR/.env"
if [ ! -f "$ENV_FILE" ]; then
  cp "$SCRIPT_DIR/.env.example" "$ENV_FILE"
  echo "Created .env from .env.example — edit it with your credentials."
fi

SHELL_FUNC="
# claude-sandbox - run Claude Code in an isolated Docker container
CLAUDE_SANDBOX_DIR=\"$SCRIPT_DIR\"
claude-sandbox() {
  local env_file=\"\$CLAUDE_SANDBOX_DIR/.env\"
  docker run --rm -it \
    --env-file \"\$env_file\" \
    -v \"\$(pwd):/workspaces/project\" \
    -w /workspaces/project \
    claude-sandbox \
    claude --dangerously-skip-permissions \"\$@\"
}"

# Detect shell config file
if [ -n "${ZSH_VERSION:-}" ] || [ "$SHELL" = "/bin/zsh" ]; then
  RC_FILE="$HOME/.zshrc"
else
  RC_FILE="$HOME/.bashrc"
fi

# Check if already installed
if grep -q 'claude-sandbox()' "$RC_FILE" 2>/dev/null; then
  echo "claude-sandbox function already exists in $RC_FILE"
else
  echo "$SHELL_FUNC" >> "$RC_FILE"
  echo "Added claude-sandbox function to $RC_FILE"
fi

echo ""
echo "Done! Run 'source $RC_FILE' or open a new terminal, then:"
echo "  cd /path/to/any/project"
echo "  claude-sandbox"
